# Local secrets for Telegram. Copy to `.env` and fill in.
# `.env` is gitignored and must never be committed.
#
# Unattended scrape + board deploy is GitHub Actions (not a local server).
# There is no `python main.py serve`. In CI, set the same names as repo
# secrets (Settings → Secrets and variables → Actions). Pages board:
# Settings → Pages → Source GitHub Actions.
#
# TELEGRAM_BOT_TOKEN: from @BotFather after /newbot
# TELEGRAM_CHAT_ID: message the bot, then run `python main.py chat-id`

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
