# Local secrets for Telegram. Copy to `.env` and fill in.
# `.env` is gitignored and must never be committed.
#
# GitHub Actions uses repo secrets instead of this file.
#
# TELEGRAM_BOT_TOKEN: from @BotFather after /newbot
# TELEGRAM_CHAT_ID: message the bot, then run `python main.py chat-id`

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
